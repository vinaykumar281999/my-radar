# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never prefix with NEXT_PUBLIC_): the service_role / secret key.
# Used only by the server actions that save "I'm Interested" and pitch submissions,
# and by the private calendar feed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile (invisible widget). Leave both empty in development to
# skip verification; in production, submissions are rejected without the secret.
# Test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: public URL used in share links / OG images (defaults to the request host)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
